<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzg.psychologyai.infrastructure.persistence.mapper.ConsultationMessageMapper">

    <!--
        咨询消息表（docs/ai-agent.sql 的 consultation_message 表）基础映射。
        namespace 必须与 ConsultationMessageMapper 接口全限定名一致。
    -->
    <resultMap id="BaseResultMap" type="com.zzg.psychologyai.infrastructure.persistence.po.ConsultationMessagePO">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="sender_type" property="senderType"/>
        <result column="message_type" property="messageType"/>
        <result column="content" property="content"/>
        <result column="emotion_tag" property="emotionTag"/>
        <result column="ai_model" property="aiModel"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="deleted_flag" property="deletedFlag"/>
    </resultMap>

    <!-- 基础列清单，供自定义 SQL 复用 -->
    <sql id="Base_Column_List">
        id, session_id, sender_type, message_type, content, emotion_tag, ai_model,
        create_time, update_time, created_by, updated_by, deleted_flag
    </sql>

    <!-- 按会话ID查询未删除消息，按创建时间升序（对应 Mapper 的 selectBySessionId） -->
    <select id="selectBySessionId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from consultation_message
        where deleted_flag = 0 and session_id = #{sessionId}
        order by create_time asc
    </select>

    <!-- 查询会话最新一条消息（对应 Mapper 的 selectLatestBySessionId），同秒时以 id 倒序兜底 -->
    <select id="selectLatestBySessionId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from consultation_message
        where deleted_flag = 0 and session_id = #{sessionId}
        order by create_time desc, id desc
        limit 1
    </select>

</mapper>
