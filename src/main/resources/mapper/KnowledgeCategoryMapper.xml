<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzg.psychologyai.infrastructure.persistence.mapper.KnowledgeCategoryMapper">

    <!--
        用户文章收藏表（docs/ai-agent.sql 的 user_favorite 表）基础映射。
        namespace 必须与 UserFavoriteMapper 接口全限定名一致。
    -->
    <resultMap id="BaseResultMap" type="com.zzg.psychologyai.infrastructure.persistence.po.KnowledgeCategoryPO">
        <id column="id" property="id"/>
        <result column="category_name" property="categoryName"/>
        <result column="description" property="description"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="deleted_flag" property="deletedFlag"/>
    </resultMap>

    <!-- 基础列清单，供自定义 SQL 复用 -->
    <sql id="Base_Column_List">
        id, category_name, description,sort_order, status,
        create_time, update_time, created_by, updated_by, deleted_flag
    </sql>




</mapper>