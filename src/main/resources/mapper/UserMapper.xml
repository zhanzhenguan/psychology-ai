<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzg.psychologyai.infrastructure.persistence.mapper.UserMapper">

    <!--
        用户表（docs/ai-agent.sql 的 user 表）基础映射。
        namespace 必须与 UserMapper 接口全限定名一致；
        当前常规 CRUD 由 MyBatis-Plus BaseMapper 提供，本文件用于承载后续自定义 SQL，
        避免在 Java 代码中拼接 SQL 字符串。
    -->
    <resultMap id="BaseResultMap" type="com.zzg.psychologyai.infrastructure.persistence.po.UserPO">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="email" property="email"/>
        <result column="phone" property="phone"/>
        <result column="password" property="password"/>
        <result column="nickname" property="nickname"/>
        <result column="avatar" property="avatar"/>
        <result column="gender" property="gender"/>
        <result column="birthday" property="birthday"/>
        <result column="user_type" property="userType"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="deleted_flag" property="deletedFlag"/>
    </resultMap>

    <!-- 基础列清单，供自定义 SQL 复用 -->
    <sql id="Base_Column_List">
        id, username, email, phone, password, nickname, avatar, gender, birthday,
        user_type, status, create_time, update_time, created_by, updated_by, deleted_flag
    </sql>


    <select id="selectByUsername" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from user where username = #{username} and deleted_flag = 0
    </select>

</mapper>
